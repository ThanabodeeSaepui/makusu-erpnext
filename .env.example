# ------------------------------------------------------------------------------
# .env.example
# Copy this to .env and update the values before running Docker Compose.
# ------------------------------------------------------------------------------

# The domain name for your site (e.g., erp.mycompany.com, or localhost for dev)
SITE_NAME=localhost

# MariaDB Root Password (Used for database creation)
MYSQL_ROOT_PASSWORD=super_secure_database_password_here

# Administrator password for the ERPNext Web UI
ADMIN_PASSWORD=super_secure_admin_password_here

ENCRYPTION_KEY=